# Production environment template — Hostinger shared hosting.
#
# This file documents the values that become the `HOSTINGER_APP_ENV` GitHub
# secret. Copy it, fill in the real values, and paste the result as the secret.
# It is NEVER committed with real credentials, and `.env.production` is
# gitignored.
#
# Generate a fresh key locally with:
#     php artisan key:generate --show
# and paste the `base64:...` value below. Do NOT reuse the local dev key: a
# leaked or shared APP_KEY lets an attacker forge encrypted cookies and
# sessions, and this app encrypts session data.

APP_NAME=DevFolio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------
# Hostinger gives you a MySQL database from hPanel (Databases -> MySQL
# Databases). The prefix (usually `u123456789_`) is part of both the database
# and user name and is added automatically by hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_devfolio
DB_USERNAME=u123456789_devfolio
DB_PASSWORD=

# --- Session / cache / queue ---------------------------------------------
# All three use the database driver. On shared hosting there is no Redis and no
# long-running queue worker, so:
#   - sessions and cache live in MySQL (already migrated)
#   - QUEUE_CONNECTION=database is safe because nothing critical depends on a
#     background worker being alive; jobs simply wait. If you later need the
#     queue drained, Hostinger supports cron — see docs/DEPLOYMENT.md.
# SESSION_SECURE_COOKIE=true is REQUIRED: without it the session cookie is sent
# over plain HTTP and can be read by anyone on the network.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail -----------------------------------------------------------------
# Hostinger provides SMTP with any mailbox you create in hPanel.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=hello@your-domain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Trusted proxies ------------------------------------------------------
# Shared hosting terminates TLS at a load balancer, so the app sees plain HTTP
# and would generate http:// URLs and fail to mark cookies Secure without this.
# `*` is acceptable behind Hostinger's proxy; the value only tells Laravel which
# upstream headers (X-Forwarded-*) to believe.
TRUSTED_PROXIES=*

# --- AI providers (optional) ---------------------------------------------
# Leave blank to disable the AI features. Do not commit real keys.
AI_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_EDITOR_TEXT_PROVIDER=
AI_EDITOR_TEXT_MODEL=
AI_EDITOR_IMAGE_PROVIDER=
AI_EDITOR_IMAGE_MODEL=
AI_EDITOR_IMAGES_ENABLED=true
AI_EDITOR_MAX_TOKENS=2048
AI_EDITOR_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
