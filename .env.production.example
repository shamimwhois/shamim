# ---------------------------------------------------------------------------
# DevFolio — production environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` on the production server and fill in the values.
# Never commit the real `.env`. It is intentionally NOT deployed by CI; the
# file lives on the server and survives each release.
#
#   cp .env.production.example .env
#   php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME=DevFolio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devfolio
DB_USERNAME=devfolio
DB_PASSWORD=

# SQLite alternative (single-file database):
# DB_CONNECTION=sqlite
# DB_DATABASE=/home/devfolio/htdocs/database/database.sqlite

# ---------------------------------------------------------------------------
# Sessions, cache and queues
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Portfolio profile (optional overrides — see config/portfolio.php)
# ---------------------------------------------------------------------------
# PORTFOLIO_AUTHOR_NAME="Shamim Hossain"
# PORTFOLIO_AUTHOR_SHORT_NAME=shamim
# PORTFOLIO_AUTHOR_ROLE="Senior Software Engineer"
# PORTFOLIO_AUTHOR_LOCATION="Dhaka, Bangladesh"
# PORTFOLIO_AUTHOR_YEARS=9
# PORTFOLIO_AUTHOR_EMAIL="mailto:hello@example.com"
# PORTFOLIO_AUTHOR_GITHUB=https://github.com/example
# PORTFOLIO_AUTHOR_GITHUB_HANDLE=example
# PORTFOLIO_AUTHOR_LINKEDIN=https://linkedin.com/in/example
# PORTFOLIO_AUTHOR_X=https://x.com/example
# PORTFOLIO_AUTHOR_X_HANDLE=@example

VITE_APP_NAME="${APP_NAME}"
